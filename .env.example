# Copy to .env and fill in. Anything left blank runs in MOCK mode (logged to data/outbox.log).
PORT=3000
PUBLIC_URL=http://localhost:3000
ADMIN_TOKEN=change-me

# Deposit: 'true' = booking only confirmed after payment
DEPOSIT_REQUIRED=true

# Moyasar (mada / Visa / Mastercard / Apple Pay)
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# Google Calendar (service account; share each doctor calendar with its client_email, "Make changes to events")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendar IDs per doctor
CAL_KHALID=
CAL_SARAH=
CAL_RAYAN=
CAL_LINA=
CAL_HUDA=
CAL_NASSER=

# WhatsApp Cloud API (Meta). Templates must be approved. Body params: {{1}}=name {{2}}=service {{3}}=doctor {{4}}=date {{5}}=time {{6}}=manage link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_CONFIRM=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=booking_reminder_24h

# SMS (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Al Badr Elite Dental <bookings@yourdomain.com>

# Google Reviews (Places API)
GOOGLE_PLACES_KEY=
GOOGLE_PLACE_ID=
# Link patients get in the "review request" message (default: writereview link built from the place ID)
GOOGLE_REVIEW_URL=
# Review request (WhatsApp template, body vars: {{1}}=name {{2}}=doctor {{3}}=review link)
WHATSAPP_TEMPLATE_REVIEW=review_request

# Marketing / SEO (these can also be set from Admin > Marketing & SEO)
GOOGLE_MAPS_URL=
GA4_ID=
META_PIXEL_ID=
# Instagram feed: long-lived token from the Instagram API with Instagram Login (auto-refreshed)
INSTAGRAM_ACCESS_TOKEN=